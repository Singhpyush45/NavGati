# Supabase (optional). If both are empty, RehabX runs in local mode:
# data is kept in this browser's localStorage and demo accounts are available.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Pose model assets. Defaults point to the official MediaPipe CDN.
# To run fully offline, copy the files into /public/mediapipe and set:
#   VITE_MEDIAPIPE_WASM_PATH=/mediapipe/wasm
#   VITE_POSE_MODEL_URL=/mediapipe/pose_landmarker_lite.task
VITE_MEDIAPIPE_WASM_PATH=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/wasm
VITE_POSE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_lite/float16/1/pose_landmarker_lite.task
